# EHR Demo Environment Configuration
# Copy this file to .env and customize as needed

# Patient API Configuration
PATIENT_API_HOST=0.0.0.0
PATIENT_API_PORT=5001
PATIENT_DB_PATH=patients.db

# Billing Service Configuration
BILLING_SERVICE_HOST=0.0.0.0
BILLING_SERVICE_PORT=5002
